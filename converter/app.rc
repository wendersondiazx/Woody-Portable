IDI_ICON1 ICON "assets/woody-icon.ico"

#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Wendersondiazx\0"
            VALUE "FileDescription", "Woody PSP Studio\0"
            VALUE "FileVersion", "1.1.0 beta\0"
            VALUE "ProductName", "Woody PSP Studio\0"
            VALUE "ProductVersion", "1.1.0 beta\0"
            VALUE "OriginalFilename", "WoodyPSP-Studio.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
